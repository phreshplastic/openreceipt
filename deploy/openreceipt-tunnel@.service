[Unit]
Description=OpenReceipt private OpenAI MCP tunnel
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/openreceipt-tunnel
EnvironmentFile=/home/%i/openreceipt-tunnel/runtime.env
ExecStart=/home/%i/openreceipt-tunnel/bin/tunnel-client run --profile openreceipt --profile-dir /home/%i/openreceipt-tunnel/profiles
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
