{
  "name": "petes-printer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:landing-assets",
    "dev": "vite",
    "build": "npm run contracts && npm run generate:landing-assets && tsc -b && vite build && npm run build:mcp",
    "build:public": "npm run contracts && npm run generate:landing-assets && tsc -b && vite build --mode public && node scripts/generate-public-site.mjs --public && node scripts/verify-public-build.mjs",
    "contracts": "node --experimental-strip-types scripts/generate-receipt-schema.mjs",
    "generate:landing-assets": "node --import tsx scripts/generate-landing-assets.mts",
    "assets:scenes": "node scripts/generate-carousel-scenes.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "check": "npm run lint && npm run build:mcp && npm test && npm run build",
    "bridge": "python3 -m petes_printer_bridge.cli --web-dist dist",
    "bridge:test": "python3 -m pytest bridge/tests",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "mcp": "npm run build:mcp && node dist-mcp/server.mjs",
    "mcp:http": "npm run build:mcp && node dist-mcp/server.mjs --http"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-three/fiber": "^9.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shadergradient/react": "^2.4.20",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
