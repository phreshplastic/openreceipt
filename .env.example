# Copy to .env on the Docker printer host. No credentials belong here.
# Local CLI defaults; Compose uses an explicit container-internal bind.
PETES_PRINTER_HOST=127.0.0.1
PETES_PRINTER_PORT=8731
OPENRECEIPT_USB_GID=46
OPENRECEIPT_PORT=8731
OPENRECEIPT_MCP_PORT=8733
PETES_PRINTER_TRANSPORT=usb
PETES_PRINTER_ALLOWED_ORIGINS=http://127.0.0.1:8731,http://localhost:8731
PETES_PRINTER_EDITOR_URL=http://127.0.0.1:8731
PETES_PRINTER_MCP_ALLOWED_HOSTS=localhost:8733,127.0.0.1:8733
