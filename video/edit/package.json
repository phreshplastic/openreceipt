{
  "name": "openreceipt-video-edit",
  "version": "0.1.0",
  "description": "Remotion edit for the OpenReceipt WebMCP Challenge demo video",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/fonts": "4.0.520",
    "@remotion/install-whisper-cpp": "4.0.520",
    "@remotion/media": "4.0.520",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.520",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio --no-open",
    "bake": "node --experimental-strip-types scripts/bake-paper.mts",
    "stills": "node --experimental-strip-types scripts/render-stills.mts",
    "pilot": "remotion render Pilot ../exports/review/pilot.mp4",
    "film": "remotion render Film ../exports/review/rough-cut.mp4",
    "lint": "eslint src && tsc",
    "voiceover": "node --experimental-strip-types scripts/generate-voiceover.mts"
  },
  "sideEffects": [
    "*.css"
  ]
}
